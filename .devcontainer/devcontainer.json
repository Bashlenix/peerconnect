{
  "name": "PeerConnect",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {"moby": false}
  },
  "postCreateCommand": "npm ci && git config core.hooksPath .githooks && (cd apps/backend && npx prisma generate) && bash .devcontainer/setup-env.sh && bash .devcontainer/db-up.sh",
  "postStartCommand": "bash .devcontainer/setup-env.sh && bash .devcontainer/db-up.sh",
  "forwardPorts": [3001, 5173, 5432],
  "portsAttributes": {
    "5173": { "label": "Frontend (app)", "onAutoForward": "openPreview" },
    "3001": { "label": "Backend API", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  }
}
