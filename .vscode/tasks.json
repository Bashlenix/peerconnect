{
  "version": "2.0.0",
  "tasks": [
    {
      // Auto-starts the full dev stack (shared build + backend + frontend) in a
      // visible terminal whenever the workspace opens — including on Codespace
      // creation/resume. This replaces backgrounding `npm run dev` from a
      // devcontainer lifecycle hook, which was unreliable: processes started
      // there are reaped when the hook exits (nohup only blocks SIGHUP).
      "label": "Start dev servers",
      "type": "shell",
      "command": "[ -x node_modules/.bin/tsc ] || npm ci; npm run dev",
      "runOptions": { "runOn": "folderOpen" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
