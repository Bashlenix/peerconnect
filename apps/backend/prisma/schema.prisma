generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum PostCategory {
  Academic
  Social
  Sport
  DailyLifeSupport
}

enum NotificationType {
  NEW_POST_IN_CATEGORY
  REPLY_TO_POST
  REPLY_UPVOTED
  REPLY_MARKED_SOLUTION
  BADGE_AWARDED
}

enum SubscriptionStatus {
  free
  premium
}

// ──────────────────────────────────────────
// Models
// ──────────────────────────────────────────

model University {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("universities")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  firstName               String?
  lastName                String?
  studyProgramme          String?
  semester                Int?
  languages               String[]
  isVerified              Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  refreshTokenHash        String?   @unique
  refreshTokenExpiry      DateTime?
  universityId            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  university              University?             @relation(fields: [universityId], references: [id], onDelete: SetNull)
  posts                   Post[]
  replies                 Reply[]
  upvotes                 Upvote[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  userBadges              UserBadge[]
  subscription            Subscription?

  @@map("users")
}

model Post {
  id        String       @id @default(cuid())
  content   String
  category  PostCategory
  isUrgent  Boolean      @default(false)
  authorId      String
  editedAt      DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  // snake_case intentional: must match the DB-generated column name
  search_vector Unsupported("tsvector")?

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies       Reply[]
  notifications Notification[]

  @@map("posts")
}

model Reply {
  id         String    @id @default(cuid())
  content    String
  isSolution Boolean   @default(false)
  authorId   String
  postId     String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  upvotes       Upvote[]
  notifications Notification[]

  @@map("replies")
}

model Upvote {
  id        String   @id @default(cuid())
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply Reply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
  @@map("upvotes")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  postId    String?
  replyId   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)
  reply Reply? @relation(fields: [replyId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model NotificationPreference {
  id       String       @id @default(cuid())
  userId   String
  category PostCategory

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  status    SubscriptionStatus @default(free)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Ad {
  id             String    @id @default(cuid())
  title          String
  body           String
  imageUrl       String?
  linkUrl        String
  advertiserName String
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("ads")
}
