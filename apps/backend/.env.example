# Docker pre-seeded image (recommended): trust auth, no password needed.
DATABASE_URL="postgresql://postgres@localhost:5432/peerconnect"

# Local PostgreSQL (if not using Docker): adjust user as needed.
# DATABASE_URL="postgresql://<your-os-user>@localhost:5432/peerconnect"

# Email / SMTP (Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="<resend-api-key>"
EMAIL_FROM="noreply@peerconnect.de"

# JWT
JWT_SECRET="<random-32+-char-secret>"

# URLs
FRONTEND_URL="http://localhost:5173"

# AI (OpenAI)
OPENAI_API_KEY="<openai-api-key>"
