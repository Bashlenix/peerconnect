{
  "name": "@peerconnect/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "check:db-seed-imports": "node scripts/check-db-seed-imports.mjs",
    "prebuild": "npm run check:db-seed-imports",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-dev": "tsx prisma/seed-dev.ts",
    "db:seed-ads": "tsx prisma/seed-ads.ts",
    "db:seed-extended": "tsx prisma/seed-extended.ts",
    "db:backfill-top-badge": "tsx prisma/backfill-top-badge.ts"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@peerconnect/shared": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "nodemailer": "^8.0.7",
    "openai": "6.37.0",
    "pg": "^8.20.0",
    "pino": "10.3.1",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.0",
    "pino-pretty": "13.1.3",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
